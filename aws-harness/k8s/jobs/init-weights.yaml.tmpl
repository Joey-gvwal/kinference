# Job template for in-cluster `make init-weights`.
#
# Two stages — init container downloads from HuggingFace to an ephemeral
# scratch volume, main container syncs that volume to the harness's
# weights bucket via `aws s3 sync`. Pod IAM (via IRSA) comes from the
# `init-weights` ServiceAccount provisioned by terraform/init-weights.tf.
#
# Rendered by scripts/init-weights.sh from these env vars:
#   ${SLUG}         — DNS-safe id derived from PREFIX (job/pod naming)
#   ${MODEL}        — HuggingFace repo id (e.g. Qwen/Qwen3.6-35B-A3B-FP8)
#   ${PREFIX}       — S3-relative prefix, with trailing slash (e.g. weights/qwen-3-6-35b-a3b-fp8/)
#   ${BUCKET}       — destination bucket (e.g. 471112539178-us-west-2)
#   ${REGION}       — AWS region for the bucket
#   ${SCRATCH_GIB}  — ephemeral PVC size in GiB (default 100)
---
apiVersion: batch/v1
kind: Job
metadata:
  name: init-weights-${SLUG}
  namespace: default
  labels:
    mm/managed-by: model-harness
    mm/task: init-weights
  annotations:
    mm/model: "${MODEL}"
    mm/prefix: "${PREFIX}"
spec:
  # Auto-clean the Job + pod 1 hour after success/failure so re-runs
  # don't pile up old objects.
  ttlSecondsAfterFinished: 3600
  # Retry only once on failure (network blip etc.); avoid pathological
  # re-download loops.
  backoffLimit: 1
  # Hard ceiling — kills the Job regardless of progress after 3 hours.
  # Covers the worst-case 100 GB pull on a slow HuggingFace day.
  activeDeadlineSeconds: 10800
  template:
    metadata:
      labels:
        mm/managed-by: model-harness
        mm/task: init-weights
    spec:
      serviceAccountName: init-weights
      restartPolicy: Never

      # Schedule on a GPU node. Despite being a CPU-only workload, GPU
      # nodes are the right host here because:
      #   1. System nodes (t3.medium, 4 GiB RAM) can't fit the HF download
      #      — snapshot_download of 30+ GiB checkpoints OOMKills well below
      #      the node's physical RAM ceiling.
      #   2. The user has to scale up GPU nodes (`make scale-gpu N=…`)
      #      before deploying inference servers anyway. Reusing that
      #      capacity for the rare init-weights operation avoids
      #      upgrading the always-on system node group (~$60/month) for
      #      what's typically a once-per-model setup step.
      #   3. The Job doesn't request `nvidia.com/gpu`, so it shares a
      #      GPU node's CPU/RAM with inference pods without contending
      #      for the GPU itself. Memory footprint (~3-4 GiB) is
      #      negligible against the 32 GiB on a g6e.xlarge.
      #
      # IAM: the init-weights ServiceAccount carries an IRSA role with
      # s3:PutObject on the weights bucket; the GPU node's instance
      # profile only has s3:GetObject, so IRSA is required regardless.
      nodeSelector:
        role: gpu
      # Tolerate the nvidia.com/gpu taint applied to GPU nodes (see
      # terraform/eks.tf). Without this, GPU nodes refuse to schedule
      # any pod not asking for a GPU resource.
      tolerations:
        - key: nvidia.com/gpu
          operator: Equal
          value: "true"
          effect: NoSchedule

      # Ephemeral PVC: dynamically-provisioned gp3 EBS volume, lifetime
      # tied to this pod. Provisioned in whichever AZ the pod schedules
      # to (gp3 default binding mode is WaitForFirstConsumer). Removed
      # automatically when the Job's TTL fires.
      volumes:
        - name: scratch
          ephemeral:
            volumeClaimTemplate:
              metadata:
                labels:
                  mm/managed-by: model-harness
                  mm/task: init-weights
              spec:
                accessModes: ["ReadWriteOnce"]
                resources:
                  requests:
                    storage: ${SCRATCH_GIB}Gi
                # Pinned to the harness's gp3 StorageClass (created by
                # `make addons` from k8s/addons/gp3-storage-class.yaml).
                # We don't rely on the cluster default because:
                #   - the EKS managed EBS-CSI addon doesn't ship a SC,
                #   - some EKS releases default to `gp2` with Immediate
                #     binding which leaves AZ-scoped EBS PVCs unbound
                #     for zone-aware scheduling.
                storageClassName: gp3

      # ── Stage 1: HuggingFace → /scratch ───────────────────────────────
      initContainers:
        - name: hf-download
          image: python:3.11-slim
          imagePullPolicy: IfNotPresent
          env:
            # Optional Secret — for gated repos, create with:
            #   kubectl create secret generic hf-token --from-literal=token=hf_xxx
            # `optional: true` means a missing Secret doesn't fail pod start;
            # public repos download fine without a token.
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: hf-token
                  key: token
                  optional: true
            # Streams pip / huggingface_hub log lines as they happen, so
            # `kubectl logs -f` shows live progress instead of buffered chunks.
            - name: PYTHONUNBUFFERED
              value: "1"
            # Force huggingface_hub's pure-Python threaded downloader, never
            # the Rust hf_transfer accelerator. hf_transfer holds multi-MB
            # chunks per parallel worker in process memory and can spike
            # several GiB above the threaded baseline — which OOMKills the
            # container when the cgroup memory limit is tight.
            - name: HF_HUB_ENABLE_HF_TRANSFER
              value: "0"
          command: ["sh", "-c"]
          args:
            - |
              set -euo pipefail
              echo "▶  Installing huggingface_hub + boto3..."
              pip install -q --no-cache-dir 'huggingface_hub>=0.24' 'boto3>=1.34'
              echo "▶  snapshot_download ${MODEL} → /scratch  (with progress-to-S3)"
              python3 - <<'PY'
              # Out-of-band progress reporting: kubectl logs against this Job's
              # pod is often unreachable (intermittent kubelet TLS handshake
              # timeouts on newly-joined system nodes), so we write a JSON
              # progress object to S3 every 30s. Read it with:
              #   aws s3 cp s3://${BUCKET}/${PREFIX}.harness-init-weights-progress - \
              #     --region ${REGION} | jq .
              # The s3-sync container's `aws s3 sync --delete` removes this
              # object when the upload phase begins, so it self-cleans.
              import os, sys, json, time, subprocess, threading
              import boto3
              from huggingface_hub import snapshot_download

              BUCKET = "${BUCKET}"
              PREFIX = "${PREFIX}"
              REGION = "${REGION}"
              MODEL = "${MODEL}"
              SCRATCH = "/scratch"
              PROGRESS_KEY = PREFIX + ".harness-init-weights-progress"
              INTERVAL = 30  # seconds

              def human(n):
                  for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
                      if n < 1024:
                          return f"{n:.1f} {unit}"
                      n /= 1024
                  return f"{n:.1f} PiB"

              s3 = boto3.client("s3", region_name=REGION)
              stop = threading.Event()

              def write_progress(phase, **extra):
                  try:
                      size = 0
                      files = 0
                      try:
                          size = int(subprocess.check_output(
                              ["du", "-sb", SCRATCH]).split()[0])
                      except Exception:
                          pass
                      try:
                          for _, _, fs in os.walk(SCRATCH):
                              files += len(fs)
                      except Exception:
                          pass
                      body = {
                          "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                                     time.gmtime()),
                          "phase": phase,
                          "model": MODEL,
                          "bytes": size,
                          "human": human(size),
                          "files": files,
                          **extra,
                      }
                      s3.put_object(
                          Bucket=BUCKET, Key=PROGRESS_KEY,
                          Body=json.dumps(body, indent=2).encode())
                      print(f"  progress: phase={phase} bytes={size} ({human(size)}) files={files}",
                            flush=True)
                  except Exception as e:
                      print(f"  progress-write failed: {e}",
                            file=sys.stderr, flush=True)

              def loop():
                  while not stop.wait(INTERVAL):
                      write_progress("hf-download")

              write_progress("starting")
              t = threading.Thread(target=loop, daemon=True)
              t.start()

              # max_workers=2 (default 8). The real constraint is peak DISK
              # usage, not memory: snapshot_download stages each file at
              # full size in `<local_dir>/.cache/huggingface/download/
              # <file>.incomplete` before renaming into place. So peak
              # in-flight bytes ≈ max_workers × largest_shard_size. For
              # Qwen3.6-35B-A3B-FP8 the largest shard is ~32 GB, so 4
              # workers = up to 128 GB transient cache on top of already-
              # finalised files. Two workers caps that at ~64 GB, which
              # fits in a 100 GiB scratch volume with comfortable headroom
              # even for 100 GB-class repos. ~100 MB/s aggregate.
              snapshot_download(
                  repo_id=MODEL,
                  local_dir=SCRATCH,
                  token=os.environ.get("HF_TOKEN") or None,
                  max_workers=2,
              )

              stop.set()
              t.join(timeout=5)
              write_progress("hf-download-complete")
              print("✓ snapshot_download finished", flush=True)
              PY
              echo "▶  Final /scratch size:"
              du -sh /scratch | sed 's/^/   /'
          volumeMounts:
            - name: scratch
              mountPath: /scratch
          resources:
            requests:
              cpu: "500m"
              memory: "2Gi"
            limits:
              cpu: "2"
              # 8Gi is generous — peak resident is ~3-4 GiB during a
              # 36 GB pull (hf_transfer disabled + max_workers=4). GPU
              # node (g6e.xlarge) has 32 GiB total so this never bumps
              # against the node ceiling, even with an inference pod
              # also running there.
              memory: "8Gi"

      # ── Stage 2: /scratch → s3://${BUCKET}/${PREFIX} ──────────────────
      containers:
        - name: s3-sync
          image: amazon/aws-cli:2.22.0
          imagePullPolicy: IfNotPresent
          env:
            - name: AWS_REGION
              value: "${REGION}"
          command: ["sh", "-c"]
          args:
            - |
              set -euo pipefail
              echo "▶  aws s3 sync /scratch/ s3://${BUCKET}/${PREFIX}"
              aws s3 sync /scratch/ "s3://${BUCKET}/${PREFIX}" \
                --delete \
                --exclude '.cache/*' \
                --exclude '.huggingface/*'
              echo "▶  Writing sentinel"
              printf '%s' '${MODEL}' \
                | aws s3 cp - "s3://${BUCKET}/${PREFIX}.harness-init-weights"
              echo "✓  Uploaded ${MODEL} → s3://${BUCKET}/${PREFIX}"
          volumeMounts:
            - name: scratch
              mountPath: /scratch
              readOnly: true
          resources:
            requests:
              cpu: "500m"
              memory: "512Mi"
            limits:
              cpu: "2"
              memory: "2Gi"
