# Terraform local state, lock, and plan artifacts
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/tfplan

# Per-user server instance configs (the .example versions are committed)
servers/*.toml
!servers/*.toml.example

# Generated kinference config
config.aws.toml
