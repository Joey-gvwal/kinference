{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-vLLM-pod scheduler state. Top section: one stacked panel per pod (auto-generated via Grafana's repeat-by-variable feature) showing running + waiting-by-reason + swapped + preempted. Middle: KV-cache usage trend with autoscaling Y axis. Bottom: per-pod engine config snapshot from vllm:cache_config_info. Companion to the upstream Performance/Query Statistics dashboards which aggregate across pods.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "$pod",
      "description": "Scheduler state stacked: running (in-batch) + waiting/capacity (queued, engine full) + waiting/deferred (queued, transient constraints) + swapped (v0.21 swap) + preemption rate (v0.23 equivalent of swap; per-second).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "repeat": "pod",
      "repeatDirection": "v",
      "maxPerRow": 1,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 75,
            "spanNulls": true,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "running"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "waiting (capacity)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "waiting (deferred)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "swapped"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "preemption rate (req/s)"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(vllm:num_requests_running{pod=\"$pod\"})",
          "legendFormat": "running",
          "interval": "2s",
          "refId": "running"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(vllm:num_requests_waiting_by_reason{pod=\"$pod\",reason=\"capacity\"})",
          "legendFormat": "waiting (capacity)",
          "interval": "2s",
          "refId": "wait_cap"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(vllm:num_requests_waiting_by_reason{pod=\"$pod\",reason=\"deferred\"})",
          "legendFormat": "waiting (deferred)",
          "interval": "2s",
          "refId": "wait_def"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(vllm:num_requests_swapped{pod=\"$pod\"})",
          "legendFormat": "swapped",
          "interval": "2s",
          "refId": "swapped"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(vllm:num_preemptions_total{pod=\"$pod\"}[10s]))",
          "legendFormat": "preemption rate (req/s)",
          "interval": "2s",
          "refId": "preempt"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "KV cache activation — per pod",
      "description": "vllm:kv_cache_usage_perc. This is ACTIVATION (fraction of paged blocks committed to in-flight running/waiting requests), NOT total cache occupancy. When traffic is idle this drops to ~0 even if megabytes of prefix-cached KV are retained in 'free' blocks waiting for a hit — see vLLM's block_pool.get_usage() at vllm/v1/core/block_pool.py:505. Use this to predict when waiting/capacity will climb; for cache effectiveness see the hit-rate panel below. Y axis autoscales to observed max so low-activation periods aren't flattened. Yellow/red thresholds mark 75%/95%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 25,
            "spanNulls": true,
            "showPoints": "auto",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (pod) (vllm:kv_cache_usage_perc{pod=~\"$pod\"})",
          "legendFormat": "{{pod}}",
          "interval": "2s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prefix cache hit rate — per pod",
      "description": "rate(vllm:prefix_cache_hits_total[1m]) / rate(vllm:prefix_cache_queries_total[1m]). Fraction of queried prefix tokens that landed in the cache. Counts tokens, not requests — a single long request can dominate. Hit rate trending up over a run means the workload has prefix locality the engine is exploiting; flat-near-zero means each request looks fresh to the engine.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 25,
            "spanNulls": true,
            "showPoints": "auto",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (pod) (rate(vllm:prefix_cache_hits_total{pod=~\"$pod\"}[1m])) / sum by (pod) (rate(vllm:prefix_cache_queries_total{pod=~\"$pod\"}[1m]))",
          "legendFormat": "{{pod}}",
          "interval": "2s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Engine config (per pod)",
      "description": "Static config from vllm:cache_config_info — pulled from labels on a constant=1 gauge. Plus model_name joined from the running-requests metric. Snapshot at scrape time; values change only on pod restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "vllm:cache_config_info{pod=~\"$pod\"}",
          "format": "table",
          "instant": true,
          "refId": "cfg"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "group by (pod, model_name) (vllm:num_requests_running{pod=~\"$pod\"})",
          "format": "table",
          "instant": true,
          "refId": "model"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "pod",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Value #cfg": true,
              "Value #model": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "namespace": true,
              "container": true,
              "endpoint": true,
              "service": true,
              "_block_size_resolved": true,
              "calculate_kv_scales": true,
              "hash_block_size": true,
              "is_attention_free": true,
              "kv_cache_dtype_skip_layers": true,
              "kv_cache_memory_bytes": true,
              "kv_offloading_backend": true,
              "kv_offloading_size": true,
              "kv_sharing_fast_prefill": true,
              "mamba_block_size": true,
              "mamba_cache_dtype": true,
              "mamba_cache_mode": true,
              "mamba_page_size_padded": true,
              "mamba_ssm_cache_dtype": true,
              "num_cpu_blocks": true,
              "num_gpu_blocks_override": true,
              "user_specified_block_size": true,
              "user_specified_mamba_block_size": true,
              "engine": true
            },
            "indexByName": {
              "pod": 0,
              "model_name": 1,
              "block_size": 2,
              "cache_dtype": 3,
              "gpu_memory_utilization": 4,
              "num_gpu_blocks": 5,
              "enable_prefix_caching": 6,
              "prefix_caching_hash_algo": 7,
              "sliding_window": 8
            },
            "renameByName": {
              "pod": "pod",
              "model_name": "model",
              "block_size": "block_size",
              "cache_dtype": "kv_cache_dtype",
              "gpu_memory_utilization": "gpu_mem_util",
              "num_gpu_blocks": "num_gpu_blocks",
              "enable_prefix_caching": "prefix_caching",
              "prefix_caching_hash_algo": "hash_algo",
              "sliding_window": "sliding_window"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Inter-token latency, windowed mean",
      "description": "Mean decode step time per pod: Delta(_sum) / Delta(_count) of `vllm:inter_token_latency_seconds` over the rate window. NOT the raw _sum/_count ratio, which is a lifetime average since engine start and barely moves.\n\nWHY THIS IS A SATURATION SIGNAL. In continuous batching a decode step is one forward pass over the whole batch, and every sequence in it gets exactly one token. So the inter-token gap any single request observes IS the batch step time — a property of the engine at that instant, read out through whichever request happens to be decoding. Two requests on the same pod report the same number, and it does not depend on their prompt length or position. That is what makes it comparable in a way TTFT is not: TTFT is queue wait plus prefill, and prefill scales with prompt size, so a TTFT percentile mixes 'the engine is loaded' with 'someone sent a 100k prompt'.\n\nBecause each decode step contributes one observation per sequence in the batch, this ratio is a TOKEN-WEIGHTED mean: busy steps dominate. That weighting is what you want here.\n\nWHY NOT `vllm:request_time_per_output_token_seconds`. That histogram is observed once per REQUEST, so its mean is request-weighted and biased toward short generations. Verified on this cluster: its _count equals vllm:request_success_total exactly (1772), while this metric's _count equals generation_tokens_total minus one gap per request (178208 - 1772 = 176436, observed 176428). The two agree closely under a homogeneous workload and diverge once generation lengths vary.\n\nNO THRESHOLDS, deliberately. The floor is model-specific — on this fleet gemma-4-12B idles near 15 ms/token and Qwen2.5-32B near 28 ms, so any absolute line would be wrong for one of them. Calibrate per model from the observed idle floor; roughly 2-3x that floor is a reasonable starting point for 'saturated'.\n\nTWO LIMITS TO HOLD ONTO. It FLATTENS above max_num_seqs: once the batch stops growing, extra load lands in the queue and step time plateaus, so pair this with the queue-depth panel at the top for the post-knee regime. And chunked prefill schedules prefill chunks alongside decode, so a large prompt arriving inflates this even with the batch unchanged — defensible for a contention signal, but it is not a clean read on batch size.\n\n`gaps/s` on the right axis is rate(_count): how many samples the mean is computed from. A mean over a handful of gaps is noise.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "axisPlacement": "auto"
          },
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^gaps/s"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "cps"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9E9E9E"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "refId": "A",
          "range": true,
          "expr": "rate(vllm:inter_token_latency_seconds_sum{pod=~\"$pod\"}[$__rate_interval])\n/\nrate(vllm:inter_token_latency_seconds_count{pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "refId": "B",
          "range": true,
          "expr": "sum(rate(vllm:inter_token_latency_seconds_count{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "gaps/s"
        }
      ]
    }
  ],
