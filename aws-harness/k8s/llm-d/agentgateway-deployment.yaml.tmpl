# Raw agentgateway Deployment + ClusterIP Service.
#
# Instantiated twice by scripts/install-llm-d.sh (once for the default
# EPP path, once for the kinference EPP path) with different env-var
# substitutions. Both Deployments share the `app: agentgateway-llmd`
# label so a single LoadBalancer Service in llmd-gateway-public.yaml.tmpl
# can front both via named-port targeting.
#
# Rendered from these env vars:
#   NAME                  — Deployment + per-flavour Service name
#                           ("agentgateway-default" / "agentgateway-monitor")
#   CONFIGMAP             — ConfigMap holding /etc/agentgateway/config.yaml
#                           ("agentgateway-default-config" /
#                            "agentgateway-monitor-config")
#   CONTAINER_PORT        — Numeric port the agentgateway binds inside
#                           the pod ("8081" / "8082"). Must match the
#                           `binds:` port in the corresponding ConfigMap.
#   CONTAINER_PORT_NAME   — Named container port. The combined NLB
#                           Service references THIS name as targetPort,
#                           so each Service port reaches only the pods
#                           that actually have the matching named port.
#                           ("agw-default" / "agw-monitor")
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${NAME}
  namespace: llmd
  labels:
    app.kubernetes.io/name: ${NAME}
    app.kubernetes.io/part-of: llm-d-harness
    app: agentgateway-llmd
    mm/managed-by: model-harness
spec:
  replicas: 1
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: ${NAME}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ${NAME}
        app: agentgateway-llmd
        mm/managed-by: model-harness
    spec:
      nodeSelector:
        role: system
      containers:
        - name: agentgateway
          # Pinned to v1.3.0-alpha.1 — matches the local binary at
          # ~/devel/llm-d-local/agentgateway/agentgateway (which is the
          # config-format reference). The chart-default v1.0.1 lacks the
          # `inferenceRouting` policy field that the config files use:
          #   Error: binds[0].listeners[0].routes[0].backends[0].policies:
          #          unknown field `inferenceRouting`
          # v1.3.0-alpha.1 supports it. If you bump the local binary,
          # bump this tag to match.
          image: cr.agentgateway.dev/agentgateway:v1.3.0-alpha.1
          imagePullPolicy: IfNotPresent
          args: ["-f", "/etc/agentgateway/config.yaml"]
          ports:
            - name: ${CONTAINER_PORT_NAME}
              containerPort: ${CONTAINER_PORT}
              protocol: TCP
          volumeMounts:
            - name: config
              mountPath: /etc/agentgateway
              readOnly: true
          readinessProbe:
            tcpSocket:
              port: ${CONTAINER_PORT_NAME}
            initialDelaySeconds: 2
            periodSeconds: 5
            failureThreshold: 3
          livenessProbe:
            tcpSocket:
              port: ${CONTAINER_PORT_NAME}
            initialDelaySeconds: 30
            periodSeconds: 30
            failureThreshold: 3
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "1"
              memory: "1Gi"
      volumes:
        - name: config
          configMap:
            name: ${CONFIGMAP}
---
apiVersion: v1
kind: Service
metadata:
  name: ${NAME}
  namespace: llmd
  labels:
    app.kubernetes.io/name: ${NAME}
    mm/managed-by: model-harness
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: ${NAME}
  ports:
    - name: ${CONTAINER_PORT_NAME}
      port: ${CONTAINER_PORT}
      targetPort: ${CONTAINER_PORT_NAME}
      protocol: TCP
