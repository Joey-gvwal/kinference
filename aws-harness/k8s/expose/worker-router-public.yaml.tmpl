# Public NLB Service fronting the worker-router pod. Together with
# worker-router-deployment.yaml.tmpl this exposes every vLLM worker's
# 8000/5557/5558 ports via a single NLB hostname, on the same
# offset-port scheme that scripts/port-forward.sh uses for localhost.
#
# Why a static 24-port listener set:
#   • NLB Service spec is constant across vLLM scale-up/down — LBC
#     doesn't reconcile the LB listeners every time a pod comes or
#     goes, only when nginx config changes.
#   • Each listener targets a NAMED containerPort on the router pod
#     (http-0, pub-0, rep-0, …, http-7, pub-7, rep-7). The router's
#     Deployment declares all 24 named ports; only the slots that
#     currently have a vLLM pod backing them have an nginx server{}
#     block listening — empty slots reject connections at the TCP
#     level, which is the right "no worker here" signal.
#
# Rendered by scripts/expose-workers.sh from these env vars:
#   ${OWNER_TAG}  — Owner tag value (`git config user.email`) so the
#                   NLB shows up under `make find-resources`.
apiVersion: v1
kind: Service
metadata:
  name: worker-router-public
  namespace: default
  labels:
    mm/managed-by: model-harness
    mm/component: worker-router-public
  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: external
    service.beta.kubernetes.io/aws-load-balancer-scheme: internet-facing
    service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: ip
    service.beta.kubernetes.io/aws-load-balancer-additional-resource-tags: "Project=model-harness,Owner=${OWNER_TAG}"
    # Cross-zone load balancing — REQUIRED here because:
    #   1. The router pod is a single replica (intentionally — one nginx
    #      handles all 24 ports for the whole worker fleet).
    #   2. NLBs default to cross-zone OFF, meaning each AZ's ENI only
    #      forwards to targets in its own AZ.
    # Without this, ~2/3 of the NLB IPs would have no target to forward
    # to → SYN drops → ZMQ clients (which pick one IP at connect time and
    # don't retry across DNS records) get a dead socket. HTTP clients
    # with happy-eyeballs retry would still work but with 2.5s delays.
    # Cost: cross-zone data transfer at ~$0.01/GB; negligible for
    # benchmark traffic.
    service.beta.kubernetes.io/aws-load-balancer-attributes: load_balancing.cross_zone.enabled=true
spec:
  type: LoadBalancer
  loadBalancerClass: service.k8s.aws/nlb
  externalTrafficPolicy: Cluster
  selector:
    app: worker-router
  ports:
    # Slot 0
    - { name: http-0, port: 8000,  targetPort: http-0, protocol: TCP }
    - { name: pub-0,  port: 5557,  targetPort: pub-0,  protocol: TCP }
    - { name: rep-0,  port: 5558,  targetPort: rep-0,  protocol: TCP }
    # Slot 1
    - { name: http-1, port: 9000,  targetPort: http-1, protocol: TCP }
    - { name: pub-1,  port: 6557,  targetPort: pub-1,  protocol: TCP }
    - { name: rep-1,  port: 6558,  targetPort: rep-1,  protocol: TCP }
    # Slot 2
    - { name: http-2, port: 10000, targetPort: http-2, protocol: TCP }
    - { name: pub-2,  port: 7557,  targetPort: pub-2,  protocol: TCP }
    - { name: rep-2,  port: 7558,  targetPort: rep-2,  protocol: TCP }
    # Slot 3
    - { name: http-3, port: 11000, targetPort: http-3, protocol: TCP }
    - { name: pub-3,  port: 8557,  targetPort: pub-3,  protocol: TCP }
    - { name: rep-3,  port: 8558,  targetPort: rep-3,  protocol: TCP }
    # Slot 4
    - { name: http-4, port: 12000, targetPort: http-4, protocol: TCP }
    - { name: pub-4,  port: 9557,  targetPort: pub-4,  protocol: TCP }
    - { name: rep-4,  port: 9558,  targetPort: rep-4,  protocol: TCP }
    # Slot 5
    - { name: http-5, port: 13000, targetPort: http-5, protocol: TCP }
    - { name: pub-5,  port: 10557, targetPort: pub-5,  protocol: TCP }
    - { name: rep-5,  port: 10558, targetPort: rep-5,  protocol: TCP }
    # Slot 6
    - { name: http-6, port: 14000, targetPort: http-6, protocol: TCP }
    - { name: pub-6,  port: 11557, targetPort: pub-6,  protocol: TCP }
    - { name: rep-6,  port: 11558, targetPort: rep-6,  protocol: TCP }
    # Slot 7
    - { name: http-7, port: 15000, targetPort: http-7, protocol: TCP }
    - { name: pub-7,  port: 12557, targetPort: pub-7,  protocol: TCP }
    - { name: rep-7,  port: 12558, targetPort: rep-7,  protocol: TCP }
