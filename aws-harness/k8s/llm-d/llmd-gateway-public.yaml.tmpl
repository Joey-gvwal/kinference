# Public NLB fronting the two raw agentgateway Deployments in the llmd
# namespace. Created by scripts/install-llm-d.sh, torn down by
# scripts/uninstall-llm-d.sh.
#
# Both backing Deployments carry the label `app: agentgateway-llmd`,
# but each pod only exposes its own named container port:
#   agentgateway-default pods  → containerPort name = agw-default (8081)
#   agentgateway-monitor pods  → containerPort name = agw-monitor (8082)
#
# When the Service's spec.ports[].targetPort is the NAME of a container
# port, K8s' endpoint-population only includes pods that actually
# declare that named port. Result: NLB :8081 routes only to the default
# Deployment's pods, NLB :8082 routes only to the monitor Deployment's
# pods, even though both share the Service's selector. No extra CRDs
# or TargetGroupBinding needed.
#
# Rendered from these env vars:
#   OWNER_TAG  — Owner tag value (`git config user.email`) so the NLB
#                shows up under `make find-resources`.
apiVersion: v1
kind: Service
metadata:
  name: llmd-gateway-public
  namespace: llmd
  labels:
    mm/managed-by: model-harness
    mm/component: llmd-gateway-public
  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: external
    service.beta.kubernetes.io/aws-load-balancer-scheme: internet-facing
    service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: ip
    service.beta.kubernetes.io/aws-load-balancer-additional-resource-tags: "Project=model-harness,Owner=${OWNER_TAG}"
spec:
  type: LoadBalancer
  loadBalancerClass: service.k8s.aws/nlb
  externalTrafficPolicy: Cluster
  selector:
    app: agentgateway-llmd
  ports:
    - name: default-epp
      port: 8081
      targetPort: agw-default
      protocol: TCP
    - name: monitor-epp
      port: 8082
      targetPort: agw-monitor
      protocol: TCP
