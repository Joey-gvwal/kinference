# Makefile.shared — Cluster-independent operations
#
# Targets here operate on shared AWS resources that are not scoped to any one
# cluster (Route 53 zone, ACM certs, S3 + CloudFront for releases, ECR image
# cache, EC2 AZ capacity).  They're safe to run without a kubeconfig set and
# do not depend on CLUSTER_NAME / TF_WORKSPACE.
#
# Usage:
#   make -f Makefile.shared dns          — provision Route 53 zone + ACM cert
#                                          for drlinky.buoyant.cloud
#   make -f Makefile.shared cdn          — provision S3 + CloudFront for
#                                          releases.drlinky.buoyant.cloud
#   make -f Makefile.shared release FILE=./artifact [KEY=custom/path]
#                                        — upload to S3 + invalidate CloudFront
#   make -f Makefile.shared unrelease KEY=artifact [PURGE=1]
#                                        — soft-delete (default) or hard-purge
#                                          a previously uploaded artifact
#   make -f Makefile.shared cache-image  — mirror llm-d-cuda from GHCR to ECR
#   make -f Makefile.shared find-az [GPU_INSTANCE_TYPES="g6e.24xlarge"]
#                                        — probe EC2 capacity by instance type
#                                          and AZ
#   make -f Makefile.shared find-aws-resources [PROJECT_TAG=inference]
#                                        — list every AWS resource tagged
#                                          Project=<PROJECT_TAG> across the
#                                          regions we deploy to
#   make -f Makefile.shared fetch-transcripts [DATE=YYYY-MM-DD | SINCE=… UNTIL=…]
#                                        — download Linky transcripts
#                                          (filtered by LastModified) for
#                                          offline processing
#   make -f Makefile.shared help         — print this list
#
# Cluster-specific ops live in Makefile (26B), Makefile.31b, Makefile.31b-awq.

AWS_REGION         ?= us-west-2
DNS_TF_DIR         := terraform-dns
CDN_TF_DIR         := terraform-cdn

# Public hostname served by the CloudFront release CDN.  `release` and
# `unrelease` use this to look up the distribution ID + origin bucket at
# runtime (via `aws cloudfront list-distributions`), so they don't require
# a functioning terraform-cdn/ state in every worktree.
RELEASES_HOST      ?= releases.drlinky.buoyant.cloud

# Tag key + value used by default_tags in terraform/, terraform-dns/,
# terraform-cdn/, and the ALB Ingress annotation.  Override on the CLI if
# you ever rename the project.
PROJECT_TAG        ?= inference

# Regions to search when tracking down tagged resources.  us-west-2 is the
# cluster + DNS + S3 region; us-east-1 is where the CloudFront ACM cert lives.
TAG_SEARCH_REGIONS ?= us-west-2 us-east-1

# Union of every cluster's GPU instance types — override on the CLI to scope
# find-az to a single type, e.g. `make find-az GPU_INSTANCE_TYPES=g6e.24xlarge`
GPU_INSTANCE_TYPES ?= g6e.xlarge g6e.2xlarge g6e.12xlarge g6e.24xlarge g5.12xlarge
K8S_VERSION        ?= 1.31

.PHONY: dns cdn release unrelease cache-image find-az find-aws-resources fetch-transcripts help

## Check real-time GPU instance capacity across all us-west-2 AZs.
## Run this before `make infra` on any cluster to pick an AZ with capacity.
find-az:
	@echo "▶  Looking up EKS GPU AMI for Kubernetes $(K8S_VERSION)..."
	@AMI=$$(aws ssm get-parameter \
	  --name /aws/service/eks/optimized-ami/$(K8S_VERSION)/amazon-linux-2-gpu/recommended/image_id \
	  --region $(AWS_REGION) --query Parameter.Value --output text 2>/dev/null); \
	if [ -z "$$AMI" ]; then echo "ERROR: could not resolve AMI"; exit 1; fi; \
	echo "   AMI: $$AMI"; \
	for TYPE in $(GPU_INSTANCE_TYPES); do \
	  echo ""; \
	  echo "  $$TYPE:"; \
	  for AZ in us-west-2a us-west-2b us-west-2c us-west-2d; do \
	    RESULT=$$(aws ec2 run-instances \
	      --region $(AWS_REGION) \
	      --instance-type $$TYPE \
	      --image-id $$AMI \
	      --count 1 \
	      --placement AvailabilityZone=$$AZ \
	      --dry-run 2>&1); \
	    if echo "$$RESULT" | grep -q "DryRunOperation"; then \
	      echo "    ✓  $$AZ — capacity available"; \
	    elif echo "$$RESULT" | grep -q "InsufficientInstanceCapacity"; then \
	      echo "    ✗  $$AZ — insufficient capacity"; \
	    elif echo "$$RESULT" | grep -q "Unsupported\|not supported"; then \
	      echo "    –  $$AZ — not offered in this AZ"; \
	    else \
	      echo "    ?  $$AZ — $$(echo $$RESULT | head -c 120)"; \
	    fi; \
	  done; \
	done; \
	echo ""

## Cache the llm-d-cuda image from GHCR to ECR (one-time per image version).
## Idempotent — skips if the tag already exists in ECR. Run from your laptop.
## Override: SOURCE_IMAGE=ghcr.io/llm-d/llm-d-cuda:vX.Y.Z ECR_TAG=vX.Y.Z make cache-image
cache-image:
	AWS_REGION=$(AWS_REGION) bash scripts/cache-image.sh

## Provision shared DNS infrastructure for drlinky.buoyant.cloud (one-time).
## Creates Route 53 hosted zone + ACM certificate. After running, add the printed
## NS records to buoyant.cloud at your registrar, then the cert auto-validates (~5 min).
dns:
	@if [ ! -d "$(DNS_TF_DIR)/.terraform" ]; then \
	  echo "▶  Initialising DNS Terraform..."; \
	  cd $(DNS_TF_DIR) && terraform init; \
	fi
	@echo "▶  Applying DNS infrastructure (drlinky.buoyant.cloud)..."
	cd $(DNS_TF_DIR) && terraform apply -auto-approve
	@echo ""
	@echo "▶  Add these NS records for drlinky.buoyant.cloud at your registrar (buoyant.cloud):"
	@cd $(DNS_TF_DIR) && terraform output -json name_servers | \
	  python3 -c "import sys,json; [print('   ', ns) for ns in json.load(sys.stdin)]"
	@echo ""
	@echo "   Once NS delegation propagates, the ACM cert validates automatically."
	@echo "   Check status: aws acm describe-certificate --region $(AWS_REGION) \\"
	@echo "     --certificate-arn \$$(cd $(DNS_TF_DIR) && terraform output -raw certificate_arn) \\"
	@echo "     --query Certificate.Status"

## Provision the S3 + CloudFront static-content CDN for releases.drlinky.buoyant.cloud.
## Requires `make -f Makefile.shared dns` to have run first (reuses the
## drlinky.buoyant.cloud zone).  Idempotent — safe to re-run.  CloudFront
## deploy takes ~3-5 minutes on first apply.
cdn:
	@if [ ! -d "$(CDN_TF_DIR)/.terraform" ]; then \
	  echo "▶  Initialising CDN Terraform..."; \
	  cd $(CDN_TF_DIR) && terraform init; \
	fi
	@echo "▶  Applying CDN infrastructure (releases.drlinky.buoyant.cloud)..."
	cd $(CDN_TF_DIR) && terraform apply -auto-approve
	@echo ""
	@echo "✓  CDN ready: $$(cd $(CDN_TF_DIR) && terraform output -raw public_url)"
	@echo "   Upload a file:  make -f Makefile.shared release FILE=./path/to/binary"

## Upload a file to the releases CDN and invalidate CloudFront cache.
## Usage:   make -f Makefile.shared release FILE=./dist/linky-cli-v1.0.0
##          make -f Makefile.shared release FILE=./dist/linky-cli-v1.0.0 KEY=linky-cli/latest
release:
	@if [ -z "$(FILE)" ]; then \
	  echo "ERROR: FILE=./path/to/file is required"; \
	  echo "       (optional: KEY=custom/s3/key — defaults to basename of FILE)"; \
	  exit 1; \
	fi
	@if [ ! -f "$(FILE)" ]; then echo "ERROR: $(FILE) not found"; exit 1; fi
	@set -e; \
	RESULT=$$(aws cloudfront list-distributions \
	    --query "DistributionList.Items[?Aliases.Items[?@=='$(RELEASES_HOST)']] | [0].[Id, Origins.Items[0].DomainName]" \
	    --output text); \
	set -- $$RESULT; DIST=$$1; ORIGIN=$$2; \
	if [ -z "$$DIST" ] || [ "$$DIST" = "None" ]; then \
	  echo "ERROR: no CloudFront distribution found with alias $(RELEASES_HOST)"; \
	  echo "       (run 'make -f Makefile.shared cdn' to provision it)"; \
	  exit 1; \
	fi; \
	BUCKET=$${ORIGIN%%.s3.*}; \
	KEY="$(KEY)"; \
	if [ -z "$$KEY" ]; then KEY=$$(basename "$(FILE)"); fi; \
	echo "▶  Uploading $(FILE) → s3://$$BUCKET/$$KEY"; \
	aws s3 cp "$(FILE)" "s3://$$BUCKET/$$KEY"; \
	echo "▶  Invalidating CloudFront cache for /$$KEY ..."; \
	aws cloudfront create-invalidation --distribution-id "$$DIST" --paths "/$$KEY" \
	  --query 'Invalidation.Id' --output text | xargs -I{} echo "   invalidation: {}"; \
	echo "✓  Available at: https://releases.drlinky.buoyant.cloud/$$KEY"

## List every AWS resource tagged Project=$(PROJECT_TAG) across the regions
## we deploy to (us-west-2 for cluster/DNS/S3, us-east-1 for CloudFront ACM
## cert).  Uses the Resource Groups Tagging API, which only returns resource
## types that support tagging — Route 53 records, CloudFront OACs, and a
## handful of others are not listed by design.
## Override: make find-aws-resources PROJECT_TAG=other-project
find-aws-resources:
	@for region in $(TAG_SEARCH_REGIONS); do \
	  echo ""; \
	  echo "── $$region ──────────────────────────────────────────────"; \
	  aws resourcegroupstaggingapi get-resources \
	    --region "$$region" \
	    --tag-filters "Key=Project,Values=$(PROJECT_TAG)" \
	    --query 'ResourceTagMappingList[].ResourceARN' \
	    --output table 2>/dev/null \
	    | sed 's/^/  /' \
	    || echo "  (no resources or API error)"; \
	done
	@echo ""
	@echo "  Note: Route 53 records, CloudFront OACs, and IAM inline policies"
	@echo "        are not tagged by AWS and therefore don't appear above."

## Remove a release artifact from S3 + invalidate its CloudFront cache.
## Soft delete (default — versioning retains prior versions so you can roll back):
##   make -f Makefile.shared unrelease KEY=linky-cli-v1.0.0
## Hard delete (purge every version + delete marker — unrecoverable):
##   make -f Makefile.shared unrelease KEY=linky-cli-v1.0.0 PURGE=1
unrelease:
	@if [ -z "$(KEY)" ]; then \
	  echo "ERROR: KEY=<s3-key> is required"; \
	  echo "       Add PURGE=1 to permanently delete all prior versions too."; \
	  exit 1; \
	fi
	@set -e; \
	RESULT=$$(aws cloudfront list-distributions \
	    --query "DistributionList.Items[?Aliases.Items[?@=='$(RELEASES_HOST)']] | [0].[Id, Origins.Items[0].DomainName]" \
	    --output text); \
	set -- $$RESULT; DIST=$$1; ORIGIN=$$2; \
	if [ -z "$$DIST" ] || [ "$$DIST" = "None" ]; then \
	  echo "ERROR: no CloudFront distribution found with alias $(RELEASES_HOST)"; \
	  exit 1; \
	fi; \
	BUCKET=$${ORIGIN%%.s3.*}; \
	if [ -n "$(PURGE)" ]; then \
	  echo "▶  Hard-deleting every version of $(KEY) from s3://$$BUCKET ..."; \
	  for KIND in Versions DeleteMarkers; do \
	    aws s3api list-object-versions --bucket "$$BUCKET" --prefix "$(KEY)" \
	      --query "$$KIND[?Key=='$(KEY)'].VersionId" --output text 2>/dev/null \
	      | tr '\t' '\n' \
	      | while read -r VID; do \
	          [ -z "$$VID" ] && continue; \
	          aws s3api delete-object --bucket "$$BUCKET" --key "$(KEY)" --version-id "$$VID" >/dev/null; \
	          echo "   deleted $$KIND $$VID"; \
	        done; \
	  done; \
	  echo "✓  All versions of $(KEY) purged"; \
	else \
	  echo "▶  Soft-deleting $(KEY) from s3://$$BUCKET (prior version retained) ..."; \
	  aws s3 rm "s3://$$BUCKET/$(KEY)"; \
	fi; \
	echo "▶  Invalidating CloudFront cache for /$(KEY) ..."; \
	aws cloudfront create-invalidation --distribution-id "$$DIST" --paths "/$(KEY)" \
	  --query 'Invalidation.Id' --output text | xargs -I{} echo "   invalidation: {}"; \
	echo "✓  Done"

## Download Linky transcripts for offline processing.
##
## Linky writes one gzipped JSON object per conversation at a stable key:
##   s3://471112539178-us-west-2/transcripts/<conversation_id>.json.gz
## Each turn overwrites the key, so the current version is always the fullest
## transcript.  We filter by S3 LastModified to scope a download window.
##
## Usage:
##   make -f Makefile.shared fetch-transcripts DATE=2026-04-21
##   make -f Makefile.shared fetch-transcripts SINCE=2026-04-01 UNTIL=2026-04-22
##   make -f Makefile.shared fetch-transcripts                    # all of them
##   [DEST=./local-transcripts]  [PARALLEL=8]
fetch-transcripts:
	@DEST="$${DEST:-./local-transcripts}"; \
	PARALLEL="$${PARALLEL:-8}"; \
	if [ -n "$(DATE)" ]; then \
	  case "$(DATE)" in \
	    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; \
	    *) echo "ERROR: DATE must be YYYY-MM-DD (got: $(DATE))"; exit 1 ;; \
	  esac; \
	  SINCE="$(DATE)T00:00:00Z"; \
	  NEXT=$$(python3 -c "import datetime as d; print((d.date.fromisoformat('$(DATE)')+d.timedelta(days=1)).isoformat())"); \
	  UNTIL="$${NEXT}T00:00:00Z"; \
	  LABEL="$(DATE)"; \
	elif [ -n "$(SINCE)" ] || [ -n "$(UNTIL)" ]; then \
	  SINCE="$${SINCE:-1970-01-01}T00:00:00Z"; \
	  UNTIL="$${UNTIL:-9999-12-31}T00:00:00Z"; \
	  LABEL="$${SINCE}_to_$${UNTIL}"; \
	else \
	  SINCE="1970-01-01T00:00:00Z"; \
	  UNTIL="9999-12-31T00:00:00Z"; \
	  LABEL="all"; \
	fi; \
	DST="$$DEST/$$LABEL"; \
	mkdir -p "$$DST"; \
	echo "▶  Listing transcripts with LastModified in [$$SINCE, $$UNTIL)..."; \
	KEYS=$$(aws s3api list-objects-v2 \
	  --bucket 471112539178-us-west-2 \
	  --prefix transcripts/ \
	  --query "Contents[?LastModified>='$$SINCE' && LastModified<'$$UNTIL'].Key" \
	  --output text --region $(AWS_REGION) 2>/dev/null | tr '\t' '\n' | grep -v '^$$' || true); \
	if [ -z "$$KEYS" ]; then \
	  echo "⚠  No transcripts in range"; \
	  exit 0; \
	fi; \
	COUNT=$$(echo "$$KEYS" | wc -l | tr -d ' '); \
	echo "▶  Downloading $$COUNT object(s) → $$DST  (parallel=$$PARALLEL)"; \
	echo "$$KEYS" | xargs -n1 -P$$PARALLEL -I{} \
	  aws s3 cp "s3://471112539178-us-west-2/{}" "$$DST/" \
	    --region $(AWS_REGION) --only-show-errors; \
	echo "✓  $$COUNT transcript(s) in $$DST"; \
	echo "   Inspect one:"; \
	echo "     zcat $$DST/<conversation_id>.json.gz | jq ."

## Print available targets.
help:
	@grep -E '^##' Makefile.shared | sed 's/^## //'
